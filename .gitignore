# Virtual environment
venv/
__pycache__/
*.pyc

# Secrets
.env

# Data (raw/interim/processed data can be large or user-specific;
# keep folder structure via .gitkeep, exclude actual data files)
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Trained model artifacts (can be large; document how to regenerate instead)
models/*
!models/.gitkeep

# Experiment outputs are mostly small JSON/CSV and ARE worth committing
# for portfolio/grading purposes — do NOT exclude experiments/

# Jupyter
.ipynb_checkpoints/

# VS Code
.vscode/

# pytest cache
.pytest_cache/

# OS-specific
Thumbs.db
.DS_Store

# Streamlit
.streamlit/secrets.toml